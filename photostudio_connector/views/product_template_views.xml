<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.photostudio.connector</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Photostudio" name="photostudio_connector" groups="photostudio_connector.group_photostudio_user">
                    <group>
                        <group string="Generate Images">
                            <button name="action_photostudio_generate_ghost" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Ghost Mannequin" class="btn-primary"/>
                            <button name="action_photostudio_generate_on_model" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate On-model"/>
                            <button name="action_photostudio_generate_lifestyle" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Lifestyle"/>
                            <button name="action_photostudio_generate_flatlay" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Flatlay"/>
                            <button name="action_photostudio_generate_photoshoot" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Photoshoot"/>
                            <button name="action_photostudio_generate_detail" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Detail"/>
                            <button name="action_photostudio_generate_campaign" type="object" groups="photostudio_connector.group_photostudio_user" string="Marketplace Export"/>
                        </group>
                        <group string="Status">
                            <field name="photostudio_sync_state"/>
                            <field name="last_generation"/>
                            <field name="last_job_id"/>
                            <field name="generated_images_count"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_view" model="ir.ui.view">
        <field name="name">product.product.form.inherit.photostudio.connector</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Photostudio" name="photostudio_connector" groups="photostudio_connector.group_photostudio_user">
                    <group>
                        <group string="Generate Images">
                            <button name="action_photostudio_generate_ghost" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Ghost Mannequin" class="btn-primary"/>
                            <button name="action_photostudio_generate_on_model" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate On-model"/>
                            <button name="action_photostudio_generate_lifestyle" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Lifestyle"/>
                            <button name="action_photostudio_generate_flatlay" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Flatlay"/>
                            <button name="action_photostudio_generate_photoshoot" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Photoshoot"/>
                            <button name="action_photostudio_generate_detail" type="object" groups="photostudio_connector.group_photostudio_user" string="Generate Detail"/>
                            <button name="action_photostudio_generate_campaign" type="object" groups="photostudio_connector.group_photostudio_user" string="Marketplace Export"/>
                        </group>
                        <group string="Status">
                            <field name="photostudio_sync_state"/>
                            <field name="last_generation"/>
                            <field name="last_job_id"/>
                            <field name="generated_images_count"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_product_generate_with_photostudio" model="ir.actions.act_window">
        <field name="name">Generate with Photostudio</field>
        <field name="res_model">photostudio.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('photostudio_connector.group_photostudio_user'))]"/>
    </record>
</odoo>
