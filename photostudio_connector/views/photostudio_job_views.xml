<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_photostudio_job_list" model="ir.ui.view">
        <field name="name">photostudio.job.list</field>
        <field name="model">photostudio.job</field>
        <field name="arch" type="xml">
            <list string="Photostudio Jobs" default_order="create_date desc" create="0" edit="0" delete="0">
                <field name="job_id" string="Job"/>
                <field name="product_tmpl_id"/>
                <field name="requesting_user_id" groups="base.group_system" optional="hide"/>
                <field name="company_id" groups="base.group_system" optional="hide"/>
                <field name="operation"/>
                <field name="status" decoration-success="status == 'completed'" decoration-danger="status == 'failed'" decoration-muted="status == 'cancelled'" decoration-info="status in ('queued', 'processing')"/>
                <field name="writeback_state"/>
                <field name="download_attempts"/>
                <field name="create_date" string="Created"/>
                <field name="authorization_blocked"/>
                <field name="completed_at" string="Finished"/>
            </list>
        </field>
    </record>

    <record id="view_photostudio_job_form" model="ir.ui.view">
        <field name="name">photostudio.job.form</field>
        <field name="model">photostudio.job</field>
        <field name="arch" type="xml">
            <form string="Photostudio Job" create="0" edit="0" delete="0">
                <header>
                    <button name="action_poll_status" type="object" string="Poll Status" class="btn-secondary" groups="photostudio_connector.group_photostudio_user" invisible="not authorization_blocked and status in ('completed', 'failed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" groups="photostudio_connector.group_photostudio_user" invisible="status != 'queued'"/>
                    <button name="action_retry_writeback" type="object" string="Retry image download" class="btn-secondary" groups="photostudio_connector.group_photostudio_user" invisible="status != 'completed' or writeback_state not in ('expired', 'failed')"/>
                    <field name="status" widget="statusbar" statusbar_visible="queued,processing,completed,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="job_id"/>
                        <h1><field name="job_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="product_id"/>
                            <field name="requesting_user_id" groups="base.group_system"/>
                            <field name="company_id" groups="base.group_system"/>
                            <field name="operation"/>
                            <field name="job_type"/>
                            <field name="batch_id"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="progress"/>
                            <field name="writeback_state"/>
                            <field name="download_attempts"/>
                            <field name="main_output_attached"/>
                            <field name="authorization_blocked"/>
                            <field name="created_at"/>
                            <field name="updated_at"/>
                            <field name="completed_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="replace_strategy"/>
                        <field name="auto_publish" string="Publish product after automatic image writeback"/>
                        <field name="output_count"/>
                    </group>
                    <notebook>
                        <page string="Outputs">
                            <field name="outputs" widget="json"/>
                        </page>
                        <page string="Errors">
                            <field name="error_message"/>
                            <field name="errors" widget="json"/>
                        </page>
                        <page string="Metadata">
                            <field name="metadata" widget="json"/>
                            <field name="links" widget="json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_photostudio_job_search" model="ir.ui.view">
        <field name="name">photostudio.job.search</field>
        <field name="model">photostudio.job</field>
        <field name="arch" type="xml">
            <search string="Photostudio Jobs">
                <field name="job_id"/>
                <field name="product_tmpl_id"/>
                <field name="operation"/>
                <filter string="Queued" name="queued" domain="[('status', '=', 'queued')]"/>
                <filter string="Running" name="running" domain="[('status', '=', 'processing')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Attach Pending" name="writeback_pending" domain="[('writeback_state', '=', 'pending'), ('status', '=', 'completed')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                <filter string="Operation" name="group_operation" context="{'group_by': 'operation'}"/>
                <filter string="Product" name="group_product" context="{'group_by': 'product_tmpl_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_photostudio_jobs" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">photostudio.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_photostudio_job_search"/>
        <field name="group_ids" eval="[(4, ref('photostudio_connector.group_photostudio_user'))]"/>
    </record>
</odoo>
